PORT=3000
NODE_ENV=production

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, or Render PostgreSQL)
# For Render PostgreSQL: copy the "Internal Database URL" (or "External Database URL")
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# DIRECT_URL is optional (used if DATABASE_URL uses connection pooling / pgbouncer)
DIRECT_URL=""

# Clerk Authentication (From Clerk Dashboard -> API Keys)
CLERK_PUBLISHABLE_KEY="pk_test_replace_with_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_replace_with_your_clerk_secret_key"

# CORS Origin (URL of the frontend, e.g. https://fuel-wallet-frontend.onrender.com or * to allow any)
CORS_ORIGIN="*"

# Business Logic Defaults
TOPUP_MIN=1000
TOPUP_MAX=500000
BANK_LATENCY_MS=400
PENDING_TIMEOUT_SECONDS=60
