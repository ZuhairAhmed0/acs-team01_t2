generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  DRIVER
  OPERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  FROZEN
}

enum CongestionLevel {
  LOW
  MEDIUM
  HIGH
}

// Wallet types:
// - BANK_SIM: simulated bank source (single row, may go negative)
// - USER_MAIN: the user's general wallet
// - USER_STATION: the user's balance allocated to one station
// - STATION_REVENUE: a station's settlement wallet
enum WalletType {
  BANK_SIM
  USER_MAIN
  USER_STATION
  STATION_REVENUE
}

enum TransactionType {
  TOPUP
  PAYMENT
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Station {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  city       String
  address    String?
  isActive   Boolean         @default(true) @map("is_active")
  congestion CongestionLevel @default(LOW)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  operators User[]
  wallets   Wallet[]

  @@unique([name, city])
  @@map("stations")
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId       String     @unique @map("clerk_user_id")
  fullName          String?    @map("full_name")
  phone             String?
  role              UserRole   @default(DRIVER)
  status            UserStatus @default(ACTIVE)
  operatorStationId String?    @map("operator_station_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  operatorStation Station?      @relation(fields: [operatorStationId], references: [id])
  wallets         Wallet[]
  transactions    Transaction[]

  @@map("users")
}

model Wallet {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      WalletType
  userId    String?    @map("user_id") @db.Uuid
  stationId String?    @map("station_id") @db.Uuid
  balance   BigInt     @default(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User?         @relation(fields: [userId], references: [id])
  station       Station?      @relation(fields: [stationId], references: [id])
  outgoingTxns  Transaction[] @relation("TxnFromWallet")
  incomingTxns  Transaction[] @relation("TxnToWallet")
  ledgerEntries LedgerEntry[]

  @@index([userId])
  @@index([stationId])
  @@map("wallets")
}

model Transaction {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq              Int               @unique @default(autoincrement())
  type             TransactionType
  status           TransactionStatus @default(PENDING)
  userId           String            @map("user_id") @db.Uuid
  fromWalletId     String            @map("from_wallet_id") @db.Uuid
  toWalletId       String            @map("to_wallet_id") @db.Uuid
  amount           BigInt
  idempotencyKey   String            @map("idempotency_key")
  requestHash      String            @map("request_hash") @db.Char(64)
  failureCode      String?           @map("failure_code")
  failureReason    String?           @map("failure_reason")
  verificationCode String?           @map("verification_code") @db.Char(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)

  user          User          @relation(fields: [userId], references: [id])
  fromWallet    Wallet        @relation("TxnFromWallet", fields: [fromWalletId], references: [id])
  toWallet      Wallet        @relation("TxnToWallet", fields: [toWalletId], references: [id])
  ledgerEntries LedgerEntry[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("transactions")
}

model LedgerEntry {
  id            BigInt   @id @default(autoincrement())
  transactionId String   @map("transaction_id") @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  // delta is negative for money leaving a wallet and positive for money entering
  delta         BigInt
  balanceAfter  BigInt   @map("balance_after")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id])
  wallet      Wallet      @relation(fields: [walletId], references: [id])

  @@unique([transactionId, walletId])
  @@index([walletId, createdAt(sort: Desc)])
  @@map("ledger_entries")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

